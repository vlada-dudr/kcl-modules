#!/bin/bash

set -e

version=${1:-master}

cd "$(dirname "${BASH_SOURCE[0]}")/.."

clone_dir="$(mktemp -d)"
trap 'rm -rf "$clone_dir"' EXIT
crd_dir="${clone_dir}/provider-keycloak/package/crds"

git clone --depth 1 -b "${version}" https://github.com/crossplane-contrib/provider-keycloak "$clone_dir/provider-keycloak"

kcl_dir=crossplane_provider_keycloak

if [[ -d "$kcl_dir" ]] ; then
    rm -r "${kcl_dir}"
fi

kcl import -m crd -p "crossplane_provider_keycloak" "${crd_dir}/keycloak.crossplane.io"*.yaml

cd "${kcl_dir}"
rm -r k8s
kcl mod add k8s

groups=( $(find "${crd_dir}" -type f -printf '%f\n' | sed 's/_[^_]*$//' | sort | uniq) )
for g in "${groups[@]%.keycloak.crossplane.io}" ; do
    if [[ "$g" = "keycloak.crossplane.io" ]]; then
        continue
    else
        p="$g"
    fi
    kcl import -m crd -p "$p" "${crd_dir}/${g}"*.yaml
done

# delete autogenerated mod files and duplicite k8s module
rm -r ./*/kcl.mod ./*/k8s/
